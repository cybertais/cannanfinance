 // dataobj, Array - Array Object Listing from the Database
 // keyid, String or int - Key ID Element for the Record
 // idselelement, string- ID for the Select element
 // chooseItem, string - ID for the Select element
 // displayinOption, string - ID for the Select element
 function buildSelectOptionObjs(dataobj, keyid, keyattribute, idselelement, chooseItem, displayinOption) {
    let selelement = document.getElementById(idselelement);
    let elel = $(idselelement);
    for (var i = 0; i <= dataobj.length; i++) {
       selelement.remove(0);
    }
    selelement.append(createElement('option', [{
       'attribute': 'text',
       'value': chooseItem
    }, {
       'attribute': 'value',
       'value': ''
    }], []));
    $(dataobj).each(function (i, k) {
 
       let seloptionca = null;
       if (k[keyattribute] == keyid) {
          seloptionca = [{
                'attribute': 'value',
                'value': k[keyattribute]
             },
             {
                'attribute': 'selected',
                'value': 'true'
             },
             {
                'attribute': 'text',
                'value': k[displayinOption]
             },
          ];
       } else {
          seloptionca = [{
                'attribute': 'value',
                'value': k[keyattribute]
             },
             {
                'attribute': 'text',
                'value': k[displayinOption]
             },
          ];
       }
       selelement.append(createElement('option', seloptionca, []));
    });
 }
 
 function buildNewSelectOptions(dataobj, keyattribute, idselelement, chooseItem, displayinOption) {
    let selelement = document.getElementById(idselelement);
    for (var i = 0; i <= dataobj.length; i++) {
       selelement.remove(0);
    }
    selelement.append(createElement('option', [{
          'attribute': 'text',
