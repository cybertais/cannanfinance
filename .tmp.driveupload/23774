 function bs_tab_pane(para='id',c = ['tab-pane','fade']){
   let c1ca = [
      {'attribute': 'id','value': 'nav-'+para},
      {'attribute': 'role','value': 'tabpanel'},
      {'attribute': 'aria-labelledby','value': 'nav-'+para+'-tab'}
   ];
   let c1cc = c;
   return c1comp = createElement('div', c1ca, c1cc);
}

function bs_build_tabPane(id = ''){
   // component 1
   let nav = createElement('nav',[],[]);
   let div1 = createElement('div',[{'attribute': 'id','value': 'ct-' + 'nav-tab'+id},{'attribute': 'role','value': 'tablist'}],['nav','nav-tabs']);
   // component 2
   let div2 = createElement('div',[{'attribute': 'id','value': 'ct-' + 'tab-content'+id},],['tab-content']);

   // Build 
   let c=10;
   let ar = [];
   for(let i=0; i<c; i++){
      // bs_nav_link('home', ['nav-link'], true, 'Home ');
      // bs_tab_pane('home', ['tab-pane','fade']);
      if(i<1){
         div1.append(bs_nav_link('home'+i, ['nav-link','active'], true, 'Home '+i));
         div2.append(bs_tab_pane('home'+i, ['tab-pane','fade', 'show', 'active']));
      }else{
         div1.append(bs_nav_link('home'+i, ['nav-link'], false, 'Home '+i));
         div2.append(bs_tab_pane('home'+i, ['tab-pane','fade']));
      }
      
   }
   nav.append(div1);
   let f = createElement('div', [],['col-12']);
   f.append(nav);
   f.append(div2);

   return f;


}