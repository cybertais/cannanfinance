 function bs_groupbutton2(submit_id) {
    let a1ca = [];
    let a1cc = ['row'];
    let a1comp = createElement('div', a1ca, a1cc);
 
    let b1ca = [];
    let b1cc = ['col-md-12'];
    let b1comp = createElement('div', b1ca, b1cc);
 
    let b2ca = [];
    let b2cc = ['mt-5'];
    let b2comp = createElement('hr', b2ca, b2cc);
 
    let c1ca = [{
          'attribute': 'role',
          'value': 'group'
       },
       {
          'attribute': 'aria-label',
          'value': 'Action Buttons for Request form'
       },
    ];
    let c1cc = ['btn-group-sm', 'btn-group'];
    let c1comp = createElement('div', c1ca, c1cc);
 
    let d3ca = [{
          'attribute': 'type',
          'value': 'submit'
       },
       {
          'attribute': 'name',
          'value': submit_id
       },
       {
          'attribute': 'id',
          'value': submit_id
       },
       {
          'attribute': 'text',
          'value': 'Update'
       },
 
    ];
    let d3cc = ['btn', 'btn-success', 'btn-sm'];
    let d3comp = createElement('button', d3ca, d3cc);
 
    c1comp.append(d3comp);
    b1comp.append(c1comp);
    a1comp.append(b2comp);
    a1comp.append(b1comp);
 
    return a1comp;
 }
 
