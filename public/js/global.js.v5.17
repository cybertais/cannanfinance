function createElement(el, attributesObjects = [], classesObject = [], req = false) {
    let elementType = document.createElement(el);
    attributesObjects.forEach(function (element, key) {
       if (element.attribute === 'id') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'name') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'text') {
          elementType.textContent = element.value;
          elementType.required = req;
       } else if (element.attribute === 'src') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'width') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'onclick') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'placeholder') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'type') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'aria-label') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'for') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'href') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'onclick') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'min') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'max') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'data-bs-keyboard') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'tabindex') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'data-bs-dismiss') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'data-bs-backdrop') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'file') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'role') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'button') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'value') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'selected') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'data-bs-toggle') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'data-bs-target') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'aria-controls') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'aria-selected') {
          elementType.setAttribute(element.attribute, element.value);
       } else if (element.attribute === 'aria-labelledby') {
          elementType.setAttribute(element.attribute, element.value);
       }
    });
 
    classesObject.forEach(function (element, key) {
       elementType.classList.add(element);
    });
    return elementType;
}

// The @para must be in the structure of objectname_txt_b; eg - 'objectname_txt_t'
    // The @txt is a friendly name; eg - 'Name of Object'
function build_NodeText(para = '', txt = ''){
    let attr = para;
    let placeholderAndLabel = txt;
    let paraStringArray = attr.split("_");
    
    let a11ca = [];
    let a11cc = ['col-md-3','mb-2'];
    let comp11 = createElement('div', a11ca, a11cc);

    let b11ca = [
        {'attribute':'for','value':attr},
        {'attribute':'text','value':placeholderAndLabel},
    ];
    let b11cc = ['form-label'];
    let comp22 = createElement('label', b11ca, b11cc);

    let c11ca = [
        {'attribute':'name','value':attr},
        {'attribute':'id','value':attr},
        {'attribute':'type','value':'text'},
        {'attribute':'placeholder','value':placeholderAndLabel},
        {'attribute':'aria-label','value':attr},
    ];
    let c11cc = ['form-control','form-control-sm'];
    let comp33 = createElement('input', c11ca, c11cc);

    if(paraStringArray[2] === 't'){
        let spaca =  [
            {'attribute': 'text','value': '*'},
        ];
        let spacc = ['badge','badge-danger','custom-danger'];
        let spacomp = createElement('span', spaca, spacc);

        let d11ca = [];
        let d11cc = ['vali'];
        let comp44 = createElement('div', d11ca, d11cc);

        comp22.append(spacomp);
        comp11.append(comp22);
        comp11.append(comp33);
        comp11.append(comp44);
    }else{
        comp11.append(comp22);
        comp11.append(comp33);
    }
    return comp11;
}

