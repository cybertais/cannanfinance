       },
    ];
    let c1cc = ['btn', 'btn-outline-primary'];
    return createElement('button', c1ca, c1cc);
 }
 
 // dataobj, Array - Array Object Listing from the Database
 // keyid, String or int - Key ID Element for the Record
 // idselelement, string- ID for the Select element
 // chooseItem, string - ID for the Select element
 // displayinOption, string - ID for the Select element
 function buildSelectOptionObjs(dataobj, keyid, keyattribute, idselelement, chooseItem, displayinOption) {
    let selelement = document.getElementById(idselelement);
    let elel = $(idselelement);
    for (var i = 0; i <= dataobj.length; i++) {
       selelement.remove(0);
    }
    selelement.append(createElement('option', [{
       'attribute': 'text',
       'value': chooseItem
    }, {
       'attribute': 'value',
       'value': ''
    }], []));
    $(dataobj).each(function (i, k) {
 
       let seloptionca = null;
       if (k[keyattribute] == keyid) {
          seloptionca = [{
                'attribute': 'value',
                'value': k[keyattribute]
             },
             {
                'attribute': 'selected',
                'value': 'true'
             },
             {
                'attribute': 'text',
                'value': k[displayinOption]
             },
          ];
       } else {
          seloptionca = [{
                'attribute': 'value',
                'value': k[keyattribute]
             },
             {
                'attribute': 'text',
                'value': k[displayinOption]
             },
          ];
       }
       selelement.append(createElement('option', seloptionca, []));
    });
 }
 
function buildNewSelectOptions(dataobj, keyattribute, idselelement, chooseItem, displayinOption) {
   let selelement = document.getElementById(idselelement);
   selelement.innerHTML = '';
   if(dataobj.length > 0){
   selelement.append(createElement('option', [
         { 'attribute': 'text', 'value': chooseItem },
         { 'attribute': 'value', 'value': '' },
         { 'attribute': 'selected', 'value': 'true' },
      ], []));
   $(dataobj).each(function (i, k) {

   let seloptionca = null;
   seloptionca = [{
   'attribute': 'value',
   'value': k[keyattribute]
   },
   {
   'attribute': 'text',
   'value': k[displayinOption]
   },
   ];
   selelement.append(createElement('option', seloptionca, []));
   });
   }else{
   selelement.append(createElement('option', [{
   'attribute': 'text',
   'value': chooseItem
   },
   {
   'attribute': 'value',
   'value': ''
   },
   {
   'attribute': 'selected',
   'value': 'true'
   },
   ], []));
}
    
}
 
 // Return th node
 // @param l-> Label name of the Column
 // @param w-> Width of the Column in Percent , Default 10%
 function td_compile_th(l = 'Column Name', w = '10%;') {
    let c1ca = [{
          'attribute': 'width',
          'value': w
       },
       {
          'attribute': 'text',
          'value': l
       },
    ];
    let c1cc = [];
    return c1comp = createElement('th', c1ca, c1cc);
 }

// Return td node
// @param l-> Label name of the Column
 function table_build_compile_td(l = 'Column Name') {
   let c1ca = [ { 'attribute': 'text', 'value': l }];
   let c1cc = [];
   return c1comp = createElement('td', c1ca, c1cc);
}

// return tr node
// ar = [
//    {'c':'Name of Column'},
//    {'c':'Name of Column'},
// ]
function table_build_tbody_tr(ar = []) {
   let tr = createElement('tr', [], []);
   ar.forEach(function (element, key) {
      tr.append(table_build_compile_td(element.c));
   });
   return tr;
}
 
// return tr node
// ar = [
//    {'c':'Name of Column', 'w':'10%;'},
//    {'c':'Name of Column', 'w':'10%;'},
// ]
 function td_build_tr(ar = []) {
    let tr = createElement('tr', [], []);
    ar.forEach(function (element, key) {
       tr.append(td_compile_th(element.c, element.w));
    });
    return tr;
 }

 function table_build_tbody(id=''){
   let c1ca = [{'attribute': 'id','value': id}];
   let c1cc = [];
   return c1comp = createElement('tbody', c1ca, c1cc);
 }
 
 // return thead node
 function td_build_thead() {
    let c1ca = [];
    let c1cc = [];
    return c1comp = createElement('thead', c1ca, c1cc);
 }
 
 // return empty table
 function td_build_blank_table(id) {
    let c1ca = [{
          'attribute': 'id',
          'value': id
       },
       {
          'attribute': 'name',
          'value': 'name_' + id
       },
    ];
    let c1cc = ['table', 'table-striped', 'table-hover', 'table-sm'];
    return c1comp = createElement('table', c1ca, c1cc);
 }
 
 
 /** Function Name: bs_nav_link
 1) -> Parameter Accept: para - Array Default -> []
 2) -> Parameter Accept: c - Array default -> row
 3) -> Parameter Accept: bool - Array default -> row
 4) -> Parameter Accept: label - Array default -> row
 5) <- Function Returns Node Button Element
 **/
 function bs_nav_link(para, c = ['nav-link'], bool = 'false', label = 'Text') {
    let c1ca = [{
          'attribute': 'id',
          'value': 'ct_' + para
       },
       {
          'attribute': 'data-bs-toggle',
          'value': 'tab'
       },
       {
          'attribute': 'data-bs-target',
          'value': '#nav-' + para
       },
       {
          'attribute': 'type',
          'value': 'button'
       },
       {
          'attribute': 'role',
          'value': 'tab'
       },
       {
          'attribute': 'text',
          'value': label
       },
       {
          'attribute': 'aria-selected',
          'value': bool
       },
       {
          'attribute': 'aria-controls',
          'value': 'nav-' + para
       },
    ];
    let c1cc = c;
    return c1comp = createElement('button', c1ca, c1cc);
 }
 
 /** Function Name: bs_nav_link
 1) -> Parameter Accept: para - Array Default -> []
 2) -> Parameter Accept: c - Array default -> row
 3) -> Parameter Accept: bool - Array default -> row
 4) -> Parameter Accept: label - Array default -> row
 5) <- Function Returns Node Button Element
 **/
 function bs_tab_pane(para, c = ['nav-link'], bool = 'false', label = 'Text') {
    let c1ca = [{
          'attribute': 'id',
          'value': 'ct_' + para
       },
       {
          'attribute': 'data-bs-toggle',
          'value': 'tab'
       },
       {
          'attribute': 'data-bs-target',
          'value': '#nav-' + para
       },
       {
          'attribute': 'type',
          'value': 'button'
       },
       {
          'attribute': 'role',
          'value': 'tab'
       },
    ];
    let c1cc = c;
    return c1comp = createElement('div', c1ca, c1cc);
 }


 function bs_viewData(label='', data=''){
   let p = createElement('p', [], ['p1','m1']);
   let b = createElement('b', [{'attribute':'text','value':label}], ['pr-2']);
   let span = createElement('span', [], []);
   let i = createElement('i', [{'attribute':'text','value':data}], ['pl-2']);
   span.append(i);
   p.append(b);
   p.append(span);
   return p;
 }